# =============================================================================
# Backend Environment Variables
# =============================================================================

# PostgreSQL connection (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/voice_banking

# LiveKit Cloud credentials
LIVEKIT_URL=wss://your-livekit-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Backend API key (authenticates the frontend → backend requests)
BACKEND_API_KEY=your-backend-api-key

# Internal service authentication (agent ↔ backend JWT signing key)
AGENT_SERVICE_SECRET=your-agent-service-secret-jwt-key

# AI Provider — call summarization
GOOGLE_API_KEY=your-google-gemini-api-key

# CORS — comma-separated allowed origins
# Production example: https://your-app.vercel.app
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
