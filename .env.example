# =============================================================================
# Kautilya Voice Banking Assistant — Environment Variables Reference
# =============================================================================
#
# This file is a reference only. Each component has its own .env.example:
#   - backend/.env.example  — FastAPI backend (Render)
#   - agent/.env.example    — LiveKit voice agent (LiveKit Cloud)
#   - frontend/.env.example — React frontend (Vercel)
#
# Copy the relevant variables into each component's .env file for local
# development. In production, configure environment variables directly
# in each platform's dashboard (Render, LiveKit Cloud, Vercel).
#
# =============================================================================

# -----------------------------------------------------------------------------
# SHARED — LiveKit Cloud
# -----------------------------------------------------------------------------
LIVEKIT_URL=wss://your-livekit-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# -----------------------------------------------------------------------------
# SHARED — Internal Service Authentication
# -----------------------------------------------------------------------------
# Must match between backend and agent
AGENT_SERVICE_SECRET=your-agent-service-secret-jwt-key

# -----------------------------------------------------------------------------
# BACKEND (backend/.env)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/voice_banking
BACKEND_API_KEY=your-backend-api-key
GOOGLE_API_KEY=your-google-gemini-api-key
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# -----------------------------------------------------------------------------
# AGENT (agent/.env)
# -----------------------------------------------------------------------------
DEEPGRAM_API_KEY=your-deepgram-api-key
SARVAM_API_KEY=your-sarvam-api-key
# GOOGLE_API_KEY is shared with the backend
BACKEND_URL=http://127.0.0.1:8000
STT_PROVIDER=deepgram
GEMINI_MODEL=gemini-3.1-flash-lite
SARVAM_TTS_MODEL=bulbul:v3
DEFAULT_ASSISTANT=kubera
DEFAULT_LANGUAGE=en-IN

# -----------------------------------------------------------------------------
# FRONTEND (frontend/.env)
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_LIVEKIT_URL=wss://your-livekit-project.livekit.cloud
