# Backend API URL (required — set to your Render/production backend URL)
VITE_API_BASE_URL=http://localhost:8000

# LiveKit Server WebSocket URL (informational — the URL is provided by the
# backend /livekit/token endpoint at runtime, so this variable is not
# referenced in source code)
VITE_LIVEKIT_URL=wss://your-livekit-project.livekit.cloud
