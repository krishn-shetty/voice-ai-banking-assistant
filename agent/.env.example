# =============================================================================
# Agent Environment Variables
# =============================================================================

# LiveKit Cloud credentials (injected by LiveKit Cloud at runtime)
LIVEKIT_URL=wss://your-livekit-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# AI Provider credentials
GOOGLE_API_KEY=your-google-gemini-api-key
DEEPGRAM_API_KEY=your-deepgram-api-key
SARVAM_API_KEY=your-sarvam-api-key

# Agent configuration defaults
STT_PROVIDER=deepgram
GEMINI_MODEL=gemini-3.1-flash-lite
SARVAM_TTS_MODEL=bulbul:v3
DEFAULT_ASSISTANT=kubera
DEFAULT_LANGUAGE=en-IN

# Backend integration (set to your Render/production backend URL)
BACKEND_URL=http://127.0.0.1:8000

# Internal service authentication (must match backend AGENT_SERVICE_SECRET)
AGENT_SERVICE_SECRET=your-agent-service-secret-jwt-key
